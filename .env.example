OPENROUTER_API_KEY=
ORCH_UI_SECRET_KEY=
OPENROUTER_MODEL=mistralai/mistral-medium-3.1
# Model for chats with an image. Empty = the chat model if it accepts images,
# else the default mistralai/mistral-medium-3.1 (needs response_format
# json_object support). An HTTP 404 "No endpoints found for <model>" in the
# log means OpenRouter retired that model: set a current one here.
OPENROUTER_VISION_MODEL=

# v0.21.0 deployment (all optional)
# ORCH_UI_SECRET_KEY empty + ORCH_PERSIST_SECRET_KEY=1 (Docker default):
# a key is generated once and kept in state/secret_key.
ORCH_CLIENT_NAME=
ORCH_LOGO=
ORCH_TARGET_MARKET=
# /setup (first admin) always needs a token: set ORCH_SETUP_TOKEN, or leave it
# empty and copy the one-time token from the startup log
# (docker compose logs orch | grep "one-time token").
# ORCH_SETUP_LOCAL_NO_TOKEN=1 skips it for LOCAL development only.
ORCH_SETUP_TOKEN=
SESSION_COOKIE_SECURE=0
ORCH_PROXY_FIX=0
ORCH_TRUSTED_HOSTS=
